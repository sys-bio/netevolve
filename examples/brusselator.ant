// Brusselator (Prigogine & Lefever) as an open mass-action network.
//   S0 = x, S1 = y, X0 = A, X1 = B, X2 = sink for the products D and E.
//   dx/dt = A + x^2 y - B x - x
//   dy/dt = B x - x^2 y
// With A = 1, B = 3 the fixed point (x, y) = (A, B/A) is an unstable focus
// (B > 1 + A^2), so trajectories approach a limit cycle.
const X0, X1, X2;
J0: X0 -> S0; k0*X0;
J1: 2 S0 + S1 -> 3 S0; k1*S0*S0*S1;
J2: X1 + S0 -> S1 + X2; k2*X1*S0;
J3: S0 -> X2; k3*S0;
k0 = 1; k1 = 1; k2 = 1; k3 = 1;
S0 = 1; S1 = 1;
X0 = 1; X1 = 3; X2 = 0;
